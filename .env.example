# ─── Dimely Environment Variables ────────────────────────────────────────────
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Supabase → Settings → Database → URI (use "Transaction" mode pooler for Railway)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_32+_random_characters

# ── Arc / USDC Payments ───────────────────────────────────────────────────────
TREASURY_ADDRESS=0xYourTreasuryWalletAddress
VITE_TREASURY_ADDRESS=0xYourTreasuryWalletAddress
SERVER_SIGNER_PRIVATE_KEY=0xyour_treasury_wallet_private_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL after deploy
FRONTEND_URL=https://dimely.vercel.app

# ── Frontend (Vercel env vars — prefix VITE_) ─────────────────────────────────
# Set to your Railway API URL after deploy
VITE_API_URL=https://dimely-api.up.railway.app

# ── Platform ──────────────────────────────────────────────────────────────────
DIMELY_ENV=production
